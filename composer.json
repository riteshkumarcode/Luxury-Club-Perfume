{
  "name": "luxuryclub/perfumes",
  "description": "Luxury Club - The Magic of Luxury Fragrances E-Commerce Website",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "phpmailer/phpmailer": "^6.9",
    "vlucas/phpdotenv": "^5.6",
    "razorpay/razorpay": "^2.9"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/core/Helpers.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform-check": false,
    "allow-plugins": {}
  }
}
