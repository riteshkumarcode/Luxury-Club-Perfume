APP_NAME="Luxury Club"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database (MySQL 8 / MariaDB, or sqlite fallback)
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=luxury_club
DB_USERNAME=root
DB_PASSWORD=
DB_SQLITE_PATH=storage/database.sqlite

# Admin Credentials (Seeded into admin_users on first migration/seed)
ADMIN_NAME="Luxury Club Admin"
ADMIN_EMAIL=admin@luxuryclub.com
ADMIN_PASSWORD=AdminLuxury2026!
ADMIN_IP_ALLOWLIST=

# Razorpay (Stub ready; leave empty for test fallback)
# TODO: Client to provide live Razorpay credentials
RAZORPAY_KEY_ID=rzp_test_luxuryclub2026
RAZORPAY_KEY_SECRET=rzp_secret_luxuryclub2026

# SMTP Mailer (PHPMailer)
# TODO: Client to provide production SMTP credentials
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_ADDRESS=concierge@luxuryclub.com
SMTP_FROM_NAME="Luxury Club Concierge"
ADMIN_NOTIFY_EMAIL=admin@luxuryclub.com

# Security & Session
SESSION_LIFETIME=7200
CSRF_SECRET=luxury_club_super_secret_salt_key_2026
